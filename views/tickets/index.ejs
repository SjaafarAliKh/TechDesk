<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'My Tickets' }) %>
</head>

  <body>
    <%- include('../partials/navbar') %>
    <h1>My Tickets</h1>

    <% if (tickets.length === 0) { %>
      <p>You have no tickets yet. <a href="/tickets/new">Create your first ticket</a>.</p>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Created</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% tickets.forEach((ticket) => { %>
            <tr>
              <td><%= ticket.title %></td>
              <td><%= ticket.category %></td>
              <td><%= ticket.priority %></td>
              <td><%= ticket.status %></td>
              <td><%- dateTag(ticket.createdAt) %></td>
              <td><a href="/tickets/<%= ticket._id %>">View</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </body>
</html>