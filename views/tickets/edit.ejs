<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', { title: 'Edit Ticket' }) %>
</head>  

<body>
    <%- include('../partials/navbar') %>
    
    
    <% const categories=["Network", "Hardware" , "Software" , "Account" ] %>
    <% const priorities=["Low", "Medium" , "High" , "Urgent" ] %>
    <% const statuses=["Open", "In Progress" , "Resolved" , "Closed" ] %>

    <main class="container">
      <div class="card">    
    <h1>Edit Ticket</h1>
    <form action="/tickets/<%= ticket._id %>?_method=PUT" method="POST">
        <label for="title">Title:</label>
        <input type="text" name="title" id="title" maxlength="100" value="<%= ticket.title %>" required />

        <label for="description">Description:</label>
        <textarea name="description" id="description" maxlength="1000"><%= ticket.description %></textarea>

        <label for="category">Category:</label>
        <select name="category" id="category">
            <% categories.forEach(c => { %>
                <option value="<%= c %>" <%=ticket.category===c ? "selected" : "" %>><%= c %></option>                           
            <% }) %>
        </select>

        <label for="priority">Priority</label>
        <select name="priority" id="priority">
            <% priorities.forEach(p => { %>
                <option value="<%= p %>" <%=ticket.priority===p ? "selected" : "" %>><%= p %></option>
            <% }) %>
        </select>

        <label for="status">Status</label>
        <select name="status" id="status">
            <% statuses.forEach(s => { %>
                <option value="<%= s %>" <%=ticket.status===s ? "selected" : "" %>><%= s %></option>
            <% }) %>
        </select>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="/tickets/<%= ticket._id %>" class="btn">Cancel</a>
          </div>
        </form>
      </div>
    </main>
    </body>
</html>