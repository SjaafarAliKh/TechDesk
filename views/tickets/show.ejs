<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head', { title: ticket.title }) %>
  </head>
  <body>
    <%- include('../partials/navbar') %>

    <main class="container">
      <div class="card">
        <h1><%= ticket.title %></h1>

        <div class="meta">
          <span class="badge status-<%= ticket.status.toLowerCase().replace(' ', '-') %>"><%= ticket.status %></span>
          <span class="badge priority-<%= ticket.priority.toLowerCase() %>"><%= ticket.priority %> priority</span>
          <span><%= ticket.category %></span>
          <span>Created <%- dateTag(ticket.createdAt) %></span>
        </div>

        <h2>Description</h2>
        <p><%= ticket.description %></p>

        <div class="form-actions">
          <a href="/tickets/<%= ticket._id %>/edit" class="btn">Edit Ticket</a>

          <form action="/tickets/<%= ticket._id %>?_method=DELETE" method="POST">
            <button type="submit" class="btn btn-danger"
                    onclick="return confirm('Are you sure you want to delete this ticket?');">
              Delete Ticket
            </button>
          </form>

          <a href="/tickets">← Back to my tickets</a>
        </div>
      </div>

      <div class="card">
        <h2>Comments (<%= comments.length %>)</h2>

        <% if (comments.length === 0) { %>
          <p class="empty">No comments yet.</p>
        <% } else { %>
          <% comments.forEach((comment) => { %>
            <div class="comment">
              <div class="comment-header">
                <strong><%= comment.author.username %></strong>
                - <%- dateTag(comment.createdAt, true) %>
              </div>
              <p><%= comment.content %></p>
            </div>
          <% }) %>
        <% } %>

        <form action="/tickets/<%= ticket._id %>/comments" method="POST">
          <label for="content">Add a comment</label>
          <textarea name="content" id="content" maxlength="500" required></textarea>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Post Comment</button>
          </div>
        </form>
      </div>
    </main>

    <script src="/js/dates.js"></script>
  </body>
</html>